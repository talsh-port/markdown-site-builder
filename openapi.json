{
  "openapi": "3.0.0",
  "info": {
    "title": "Markdown Site Builder API",
    "description": "A RESTful API for managing markdown pages and converting them to static HTML sites",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "url": "https://github.com/talsh-port/markdown-site-builder"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Development server"
    }
  ],
  "paths": {
    "/pages": {
      "get": {
        "summary": "Get all pages",
        "description": "Retrieve a list of all pages in the system",
        "operationId": "getAllPages",
        "tags": ["Pages"],
        "responses": {
          "200": {
            "description": "Successful response with list of pages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Page"
                  }
                },
                "example": [
                  {
                    "id": "1725858123456",
                    "title": "My First Page",
                    "slug": "my-first-page",
                    "content": "# Hello World\n\nThis is my first page!",
                    "html": "<h1>Hello World</h1>\n<p>This is my first page!</p>",
                    "createdAt": "2026-09-07T10:35:23.456Z",
                    "updatedAt": "2026-09-07T10:35:23.456Z"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new page",
        "description": "Create a new markdown page and generate its static HTML output",
        "operationId": "createPage",
        "tags": ["Pages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePageRequest"
              },
              "example": {
                "title": "My First Page",
                "content": "# Hello World\n\nThis is my first page!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Page created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Title and content are required"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/pages/{id}": {
      "get": {
        "summary": "Get a single page",
        "description": "Retrieve details of a specific page by its ID",
        "operationId": "getPageById",
        "tags": ["Pages"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique page identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "description": "Page not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Page not found"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a page",
        "description": "Update an existing page's title and/or content",
        "operationId": "updatePage",
        "tags": ["Pages"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique page identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePageRequest"
              },
              "example": {
                "title": "Updated Title",
                "content": "# Updated Content\n\nThis is updated!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Page updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "description": "Page not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Page not found"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a page",
        "description": "Permanently delete a page and its output HTML file",
        "operationId": "deletePage",
        "tags": ["Pages"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique page identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "404": {
            "description": "Page not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Page not found"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Page": {
        "type": "object",
        "description": "A page object representing a markdown page",
        "required": ["id", "title", "slug", "content", "html", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the page (Unix timestamp-based)"
          },
          "title": {
            "type": "string",
            "description": "Human-readable page title"
          },
          "slug": {
            "type": "string",
            "description": "URL-safe version of title (lowercased, hyphens instead of spaces)"
          },
          "content": {
            "type": "string",
            "description": "Original markdown content"
          },
          "html": {
            "type": "string",
            "description": "Generated HTML from markdown"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of page creation"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of last update"
          }
        }
      },
      "CreatePageRequest": {
        "type": "object",
        "description": "Request body for creating a new page",
        "required": ["title", "content"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Page title",
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "description": "Markdown content for the page",
            "minLength": 1
          }
        }
      },
      "UpdatePageRequest": {
        "type": "object",
        "description": "Request body for updating a page",
        "properties": {
          "title": {
            "type": "string",
            "description": "New page title",
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "description": "New markdown content",
            "minLength": 1
          }
        }
      },
      "DeleteResponse": {
        "type": "object",
        "description": "Response for successful delete operation",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates successful deletion"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Error response",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message describing what went wrong"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Pages",
      "description": "Operations related to pages"
    }
  ]
}
